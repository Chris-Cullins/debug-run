{
  "name": "debug-run",
  "version": "0.6.0",
  "description": "CLI tool enabling AI agents to programmatically debug code via DAP",
  "type": "module",
  "main": "dist/index.cjs",
  "bin": {
    "debug-run": "dist/index.cjs"
  },
  "scripts": {
    "prepare": "husky",
    "build": "node scripts/build.mjs",
    "dev": "tsx ./src/index.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "prepack": "npm run build",
    "check": "npm run typecheck && npm run format:check && npm run test:run",
    "test:package": "node scripts/test-package.mjs"
  },
  "lint-staged": {
    "src/**/*.{ts,js}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "commander": "^15.1.0",
    "tar": "^7.5.23"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22.22.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chris-Cullins/debug-run.git"
  },
  "keywords": [
    "debug",
    "dap",
    "debugger",
    "cli",
    "ai",
    "agent"
  ],
  "author": "",
  "license": "MIT",
  "files": [
    "dist/index.cjs",
    ".claude/skills/debug-run/*.md"
  ]
}
